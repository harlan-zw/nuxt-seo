{
  "name": "@nuxtjs/seo",
  "type": "module",
  "version": "5.3.16",
  "description": "Fully equipped Technical SEO for busy Nuxters.",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://nuxtseo.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/nuxt-seo.git",
    "directory": "packages/nuxt-seo"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/nuxt-seo/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "default": "./dist/module.mjs"
    },
    "./const": "./dist/const.mjs",
    "./content": "./dist/content.mjs"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "const": [
        "./dist/const.d.mts"
      ],
      "content": [
        "./dist/content.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "dev": "nuxt dev playground",
    "dev:prepare": "nuxt-module-build prepare && nuxt prepare playground",
    "typecheck": "nuxt typecheck playground",
    "prepare:fixtures": "pnpm --dir ../shared build && nuxt prepare test/fixtures/basic && nuxt prepare test/fixtures/i18n && nuxt prepare test/fixtures/content",
    "test": "pnpm test:run",
    "test:run": "pnpm prepare:fixtures && vitest run && pnpm test:nitro-parity",
    "test:attw": "attw --pack --profile esm-only",
    "prepack": "nuxt-module-build build",
    "test:nitro-parity": "pnpm build && pnpm --dir test/fixtures/nitro2 install --frozen-lockfile && pnpm --dir test/fixtures/nuxt5 install --frozen-lockfile && node test/fixtures/nitro-parity/test.mjs"
  },
  "peerDependencies": {
    "nuxt": "^4.6.0 || ^5.0.0"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "@nuxtjs/robots": "catalog:",
    "@nuxtjs/sitemap": "catalog:",
    "nuxt-ai-ready": "catalog:",
    "nuxt-link-checker": "catalog:",
    "nuxt-og-image": "catalog:",
    "nuxt-schema-org": "catalog:",
    "nuxt-seo-utils": "catalog:",
    "nuxt-site-config": "catalog:",
    "nuxt-skew-protection": "catalog:",
    "nuxtseo-shared": "workspace:*",
    "semver": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@nuxt/content": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@nuxtjs/i18n": "catalog:",
    "@resvg/resvg-js": "catalog:",
    "@types/jest-image-snapshot": "catalog:",
    "@types/semver": "catalog:",
    "@vue/test-utils": "catalog:",
    "better-sqlite3": "catalog:",
    "execa": "catalog:",
    "happy-dom": "catalog:",
    "jest-image-snapshot": "catalog:",
    "nitropack": "catalog:",
    "nuxt": "catalog:",
    "nuxt-ai-ready": "catalog:",
    "nuxt-skew-protection": "catalog:",
    "satori": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "resolutions": {},
    "scripts": {},
    "devDependencies": {}
  }
}
