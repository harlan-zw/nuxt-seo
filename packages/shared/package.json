{
  "name": "nuxtseo-shared",
  "type": "module",
  "version": "6.0.0",
  "description": "Shared utilities for Nuxt SEO modules.",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://nuxtseo.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/nuxt-seo.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/nuxt-seo/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "default": "./dist/module.mjs"
    },
    "./content": {
      "types": "./dist/content.d.mts",
      "default": "./dist/content.mjs"
    },
    "./content-runtime": {
      "types": "./dist/content-runtime.d.mts",
      "default": "./dist/content-runtime.mjs"
    },
    "./kit": {
      "types": "./dist/kit.d.mts",
      "default": "./dist/kit.mjs"
    },
    "./devtools": {
      "types": "./dist/devtools.d.mts",
      "default": "./dist/devtools.mjs"
    },
    "./i18n": {
      "types": "./dist/i18n.d.mts",
      "default": "./dist/i18n.mjs"
    },
    "./i18n-runtime": {
      "types": "./dist/i18n-runtime.d.mts",
      "default": "./dist/i18n-runtime.mjs"
    },
    "./pro": {
      "types": "./dist/pro.d.mts",
      "default": "./dist/pro.mjs"
    },
    "./utils": {
      "types": "./dist/utils.d.mts",
      "default": "./dist/utils.mjs"
    },
    "./const": {
      "types": "./dist/const.d.mts",
      "default": "./dist/const.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./fetch": {
      "types": "./dist/fetch.d.mts",
      "default": "./dist/fetch.mjs"
    },
    "./prerender": {
      "types": "./dist/prerender.d.mts",
      "default": "./dist/prerender.mjs"
    },
    "./package.json": "./package.json",
    "./checklist": {
      "types": "./dist/checklist.d.mts",
      "default": "./dist/checklist.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "dev:prepare": "nuxt-module-build prepare",
    "stub": "nuxt-module-build build --stub",
    "test": "vitest",
    "test:run": "vitest run && pnpm test:nuxt-lanes",
    "test:nuxt5": "node scripts/test-nuxt-lanes.ts nuxt5",
    "test:attw": "attw --pack --profile esm-only",
    "typecheck": "nuxt typecheck .",
    "test:nuxt-lanes": "node scripts/test-nuxt-lanes.ts"
  },
  "peerDependencies": {
    "@nuxt/schema": "^4.6.0 || ^5.0.0",
    "nuxt": "^4.6.0 || ^5.0.0",
    "nuxt-site-config": "^4.2.3 || ^5.0.0",
    "vue": "^3.5.0",
    "zod": "^3.23.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "nuxt-site-config": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "consola": "catalog:",
    "defu": "catalog:",
    "ofetch": "catalog:",
    "radix3": "catalog:",
    "std-env": "catalog:",
    "ufo": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@harlan-zw/comark-content": "catalog:",
    "@nuxt/content": "catalog:",
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@nuxtjs/i18n": "catalog:",
    "h3": "catalog:",
    "nitropack": "catalog:",
    "nuxt": "catalog:",
    "nuxt-site-config": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
